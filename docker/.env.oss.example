# Vision Community Edition - Environment Configuration
# Copy this file to .env before starting the Docker Compose cluster:
#   cp .env.example .env

# Server Runtimes
PORT=3000
BACKEND_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_IS_CLOUD=false

# PostgreSQL Database (Metadata: users, projects, organizations)
DATABASE_URL=postgresql://vision_user:vision_password@postgres:5432/vision

# ClickHouse Analytics Database (Events, replays, traces, errors)
CLICKHOUSE_URL=http://clickhouse:8123

# Telemetry ingestion settings
DISABLE_BOT_CHECK=false
KAFKA_PRESENT=false
