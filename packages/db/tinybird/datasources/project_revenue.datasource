SCHEMA >
    `project_id`    String                    `json:$.project_id`,
    `distinct_id`   String                    DEFAULT ''  `json:$.distinct_id`,
    `session_id`    String                    DEFAULT ''  `json:$.session_id`,
    `event_id`      String                    DEFAULT ''  `json:$.event_id`,
    `event_name`    String                    DEFAULT ''  `json:$.event_name`,
    `currency`               LowCardinality(String)    DEFAULT ''  `json:$.currency`,
    `revenue`                Decimal(18, 4)            `json:$.revenue`,
    `provider`               LowCardinality(String)    DEFAULT ''  `json:$.provider`,
    `payment_connection_id`  String                    DEFAULT ''  `json:$.payment_connection_id`,
    `created_at`             DateTime64(3, 'UTC')      `json:$.created_at`

ENGINE "MergeTree"
ENGINE_PARTITION_KEY "toYYYYMM(created_at)"
ENGINE_SORTING_KEY "project_id, session_id, created_at"
ENGINE_TTL "toDateTime(created_at) + toIntervalYear(2)"

FORWARD_QUERY >
    SELECT project_id, defaultValueOfTypeName('String') AS distinct_id, session_id, event_id, event_name, currency, revenue, provider, payment_connection_id, created_at


