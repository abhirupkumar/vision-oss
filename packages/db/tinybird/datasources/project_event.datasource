SCHEMA >
    `project_id`      String          `json:$.project_id`,
    `visitor_id`      String          `json:$.visitor_id`,
    `session_id`        String          `json:$.session_id`,
    `event_id`        String          `json:$.event_id`,
    `hostname`        LowCardinality(String)  DEFAULT ''  `json:$.hostname`,
    `url_path`        String          DEFAULT ''  `json:$.url_path`,
    `url_query`       String          DEFAULT ''  `json:$.url_query`,
    `referrer_path`   String          DEFAULT ''  `json:$.referrer_path`,
    `referrer_query`  String          DEFAULT ''  `json:$.referrer_query`,
    `referrer_domain` String          DEFAULT ''  `json:$.referrer_domain`,
    `page_title`      String          DEFAULT ''  `json:$.page_title`,
    `event_type`      UInt8           DEFAULT 1   `json:$.event_type`,
    `event_name`      LowCardinality(String)  DEFAULT ''  `json:$.event_name`,
    `tag`             LowCardinality(String)  DEFAULT ''  `json:$.tag`,
    `browser`         LowCardinality(String)  DEFAULT ''  `json:$.browser`,
    `os`              LowCardinality(String)  DEFAULT ''  `json:$.os`,
    `device`          LowCardinality(String)  DEFAULT ''  `json:$.device`,
    `screen`          LowCardinality(String)  DEFAULT ''  `json:$.screen`,
    `language`        LowCardinality(String)  DEFAULT ''  `json:$.language`,
    `country`         LowCardinality(String)  DEFAULT ''  `json:$.country`,
    `region`          LowCardinality(String)  DEFAULT ''  `json:$.region`,
    `city`            String          DEFAULT ''  `json:$.city`,
    `distinct_id`     String          DEFAULT ''  `json:$.distinct_id`,
    `utm_source`      String          DEFAULT ''  `json:$.utm_source`,
    `utm_medium`      String          DEFAULT ''  `json:$.utm_medium`,
    `utm_campaign`    String          DEFAULT ''  `json:$.utm_campaign`,
    `utm_content`     String          DEFAULT ''  `json:$.utm_content`,
    `utm_term`        String          DEFAULT ''  `json:$.utm_term`,
    `gclid`           String          DEFAULT ''  `json:$.gclid`,
    `fbclid`          String          DEFAULT ''  `json:$.fbclid`,
    `msclkid`         String          DEFAULT ''  `json:$.msclkid`,
    `ttclid`          String          DEFAULT ''  `json:$.ttclid`,
    `li_fat_id`       String          DEFAULT ''  `json:$.li_fat_id`,
    `twclid`          String          DEFAULT ''  `json:$.twclid`,
    `lcp`             Nullable(Float32)  `json:$.lcp`,
    `inp`             Nullable(Float32)  `json:$.inp`,
    `cls`             Nullable(Float32)  `json:$.cls`,
    `fcp`             Nullable(Float32)  `json:$.fcp`,
    `ttfb`            Nullable(Float32)  `json:$.ttfb`,
    `latitude`        Nullable(Float32)  `json:$.latitude`,
    `longitude`       Nullable(Float32)  `json:$.longitude`,
    `created_at`      DateTime64(3, 'UTC')  `json:$.created_at`


ENGINE "MergeTree"
ENGINE_PARTITION_KEY "toYYYYMM(created_at)"
ENGINE_SORTING_KEY "toStartOfHour(created_at), project_id, visitor_id, session_id, created_at"
ENGINE_TTL "toDateTime(created_at) + toIntervalYear(2)"

FORWARD_QUERY > 
    SELECT *


