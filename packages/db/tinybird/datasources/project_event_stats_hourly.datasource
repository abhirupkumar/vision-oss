SCHEMA >
    `project_id`   String                `json:$.project_id`,
    `visitor_id`   String                `json:$.visitor_id`,
    `session_id`     String                `json:$.session_id`,
    `hostname`     LowCardinality(String)  DEFAULT ''  `json:$.hostname`,
    `browser`      LowCardinality(String)  DEFAULT ''  `json:$.browser`,
    `os`           LowCardinality(String)  DEFAULT ''  `json:$.os`,
    `device`       LowCardinality(String)  DEFAULT ''  `json:$.device`,
    `screen`       LowCardinality(String)  DEFAULT ''  `json:$.screen`,
    `language`     LowCardinality(String)  DEFAULT ''  `json:$.language`,
    `country`      LowCardinality(String)  DEFAULT ''  `json:$.country`,
    `region`       LowCardinality(String)  DEFAULT ''  `json:$.region`,
    `city`         String                DEFAULT ''  `json:$.city`,
    `event_type`   UInt8                 DEFAULT 1   `json:$.event_type`,
    `event_name`   LowCardinality(String)  DEFAULT ''  `json:$.event_name`,
    `tag`          LowCardinality(String)  DEFAULT ''  `json:$.tag`,
    `created_at`   DateTime              `json:$.created_at`,
    `min_time`     DateTime64(3, 'UTC')  `json:$.min_time`,
    `max_time`     DateTime64(3, 'UTC')  `json:$.max_time`,
    `views`        UInt64                DEFAULT 0   `json:$.views`,
    `visits`       UInt64                DEFAULT 0   `json:$.visits`

ENGINE "SummingMergeTree"
ENGINE_PARTITION_KEY "toYYYYMM(created_at)"
ENGINE_SORTING_KEY "toStartOfHour(created_at), project_id, visitor_id, session_id, event_type, event_name, tag"
ENGINE_TTL "created_at + toIntervalYear(2)"

FORWARD_QUERY >
    SELECT *
