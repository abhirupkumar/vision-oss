SCHEMA >
    `project_id`    String         `json:$.project_id`,
    `visitor_id`    String         `json:$.visitor_id`,
    `distinct_id`   String         DEFAULT ''  `json:$.distinct_id`,
    `data_key`      String         `json:$.data_key`,
    `data_type`     UInt8          DEFAULT 0   `json:$.data_type`,
    `string_value`  String         DEFAULT ''  `json:$.string_value`,
    `number_value`  Nullable(Float64)  `json:$.number_value`,
    `date_value`    Nullable(DateTime64(3, 'UTC'))  `json:$.date_value`,
    `created_at`    DateTime64(3, 'UTC')  `json:$.created_at`

ENGINE "ReplacingMergeTree"
ENGINE_PARTITION_KEY "toYYYYMM(created_at)"
ENGINE_SORTING_KEY "project_id, visitor_id, data_key"
ENGINE_TTL "toDateTime(created_at) + toIntervalYear(2)"

