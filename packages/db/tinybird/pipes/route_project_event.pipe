NODE route
SQL >
    SELECT
        project_id,
        visitor_id,
        session_id,
        event_id,
        hostname,
        url_path,
        url_query,
        referrer_path,
        referrer_query,
        referrer_domain,
        page_title,
        event_type,
        event_name,
        tag,
        browser,
        os,
        device,
        screen,
        language,
        country,
        region,
        city,
        distinct_id,
        utm_source,
        utm_medium,
        utm_campaign,
        utm_content,
        utm_term,
        gclid,
        fbclid,
        msclkid,
        ttclid,
        li_fat_id,
        twclid,
        lcp,
        inp,
        cls,
        fcp,
        ttfb,
        latitude,
        longitude,
        created_at
    FROM k_events
    WHERE stream_type = 'project_event'

TYPE materialized
DATASOURCE project_event
