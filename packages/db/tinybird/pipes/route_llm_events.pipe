NODE route
SQL >
    SELECT
        id,
        project_id,
        session_id,
        visitor_id,
        trace_id,
        parent_event_id,
        span_type,
        model,
        provider,
        prompt_tokens,
        completion_tokens,
        total_tokens,
        latency_ms,
        cost,
        cost_details,
        payload,
        response,
        metadata,
        tool_calls,
        tool_definitions,
        created_at,
        status,
        error_message,
        template_name,
        score,
        ttft_ms,
        name,
        level,
        start_time,
        end_time,
        completion_start_time,
        user_id,
        environment,
        release,
        version,
        tags,
        model_parameters,
        request_path,
        usage_unit,
        prompt_cache_read_tokens,
        prompt_cache_write_tokens,
        reasoning_tokens,
        usage_details,
        input_cost,
        output_cost,
        http_status_code,
        error_code,
        prompt_id,
        prompt_version,
        scores,
        country_code,
        body_truncated
    FROM k_events
    WHERE stream_type = 'llm_events'

TYPE materialized
DATASOURCE llm_events
